import java.util.*;

class Solution {
    public int[] pathExistenceQueries(int n, int[] nums, int maxDiff, int[][] queries) {

        int[][] arr = new int[n][2];

        for (int i = 0; i < n; i++) {
            arr[i][0] = nums[i];
            arr[i][1] = i;
        }

        Arrays.sort(arr, (a, b) -> a[0] - b[0]);

        int LOG = 20;
        int[][] up = new int[n][LOG];

        int r = n - 1;

        for (int l = n - 1; l >= 0; l--) {

            while (arr[r][0] - arr[l][0] > maxDiff) {
                r--;
            }

            int from = arr[l][1];
            int to = arr[r][1];

            up[from][0] = to;

            for (int k = 1; k < LOG; k++) {
                up[from][k] = up[up[from][k - 1]][k - 1];
            }
        }

        int[] ans = new int[queries.length];

        for (int t = 0; t < queries.length; t++) {

            int u = queries[t][0];
            int v = queries[t][1];

            if (nums[u] > nums[v]) {
                int temp = u;
                u = v;
                v = temp;
            }

            if (u == v) {
                ans[t] = 0;
                continue;
            }

            if (nums[u] == nums[v]) {
                ans[t] = 1;
                continue;
            }

            int steps = 0;

            for (int k = LOG - 1; k >= 0; k--) {
                if (nums[up[u][k]] < nums[v]) {
                    steps += 1 << k;
                    u = up[u][k];
                }
            }

            if (nums[up[u][0]] < nums[v]) {
                ans[t] = -1;
            } else {
                ans[t] = steps + 1;
            }
        }

        return ans;
    }
}
