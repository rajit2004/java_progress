class Solution {

    private static final long LIMIT = 1000001;

    public String smallestPalindrome(String s, int k) {

        int[] freq = new int[26];

        for (char ch : s.toCharArray()) {
            freq[ch - 'a']++;
        }

        char middle = 0;

        // Find middle character (if any)
        for (int i = 0; i < 26; i++) {
            if (freq[i] % 2 == 1) {
                middle = (char) ('a' + i);
                freq[i]--;
                break;
            }
        }

        // Build frequency of first half
        int[] half = new int[26];
        int len = 0;

        for (int i = 0; i < 26; i++) {
            half[i] = freq[i] / 2;
            len += half[i];
        }

        // Check if kth palindrome exists
        if (countWays(half) < k) {
            return "";
        }

        StringBuilder left = new StringBuilder();

        // Build left half greedily
        for (int pos = 0; pos < len; pos++) {

            for (int c = 0; c < 26; c++) {

                if (half[c] == 0)
                    continue;

                half[c]--;

                long ways = countWays(half);

                if (ways >= k) {
                    left.append((char) ('a' + c));
                    break;
                } else {
                    k -= ways;
                    half[c]++;
                }
            }
        }

        String right = new StringBuilder(left).reverse().toString();

        if (middle == 0) {
            return left.toString() + right;
        }

        return left.toString() + middle + right;
    }

    // Counts number of distinct permutations
    private long countWays(int[] half) {

        int total = 0;

        for (int x : half) {
            total += x;
        }

        long ans = 1;

        for (int i = 0; i < 26; i++) {

            ans *= nCr(total, half[i]);

            if (ans >= LIMIT)
                return LIMIT;

            total -= half[i];
        }

        return ans;
    }

    // Computes nCr (capped at LIMIT)
    private long nCr(int n, int r) {

        if (r > n)
            return 0;

        r = Math.min(r, n - r);

        long ans = 1;

        for (int i = 1; i <= r; i++) {

            ans = ans * (n - i + 1) / i;

            if (ans >= LIMIT)
                return LIMIT;
        }

        return ans;
    }
}
